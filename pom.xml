<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wenkrang</groupId>
    <artifactId>Famara</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>FamaraV2</name>

    <properties>
        <!-- Java 25 target: shared FFM arenas give staging buffers deterministic lifetime. -->
        <java.version>25</java.version>
        <famara.bundledDir>${project.basedir}/.claude/generated/embedded-base</famara.bundledDir>
        <famara.assets.bootstrap>false</famara.assets.bootstrap>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <craftengine.version>26.9.2</craftengine.version>
        <surefire.version>3.5.5</surefire.version>
    </properties>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><version>3.1.0</version>
                <executions><execution><id>verify-bundled-base</id><phase>process-resources</phase><goals><goal>run</goal></goals>
                    <configuration><skip>${famara.assets.bootstrap}</skip><target>
                        <available file="${famara.bundledDir}/render-base/base-26.3.zip" property="base.present"/>
                        <fail unless="base.present" message="缺少内置基础资源；先用bootstrap compile编译BundledBaseBuilder，再提供客户端生成私有资源目录。"/>
                        <checksum file="${famara.bundledDir}/render-base/base-26.3.zip" algorithm="SHA-256" property="actual.base.sha"/>
                        <loadfile property="expected.base.sha" srcFile="${famara.bundledDir}/render-base/base-26.3.zip.sha256"><filterchain><striplinebreaks/></filterchain></loadfile>
                        <condition property="base.verified"><equals arg1="${actual.base.sha}" arg2="${expected.base.sha}"/></condition>
                        <fail unless="base.verified" message="内置基础资源SHA256不符，不构建缺资源或损坏的正式包。"/>
                        <checksum file="${famara.bundledDir}/render-base/manifest.json" algorithm="SHA-256" property="actual.manifest.sha"/>
                        <loadfile property="expected.manifest.sha" srcFile="${famara.bundledDir}/render-base/manifest.json.sha256"><filterchain><striplinebreaks/></filterchain></loadfile>
                        <condition property="manifest.verified"><equals arg1="${actual.manifest.sha}" arg2="${expected.manifest.sha}"/></condition>
                        <fail unless="manifest.verified" message="内置资源清单损坏。"/>
                    </target></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <argLine>-Xmx768m -XX:MaxDirectMemorySize=128m -XX:MaxMetaspaceSize=256m -XX:ActiveProcessorCount=2 -javaagent:"${settings.localRepository}/org/mockito/mockito-core/5.23.0/mockito-core-5.23.0.jar"</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <relocations>
                        <relocation>
                            <pattern>org.objectweb.asm</pattern>
                            <shadedPattern>com.wenkrang.famara.internal.asm</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.bstats</pattern>
                            <shadedPattern>com.wenkrang.famara</shadedPattern>
                        </relocation>
                    </relocations>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource><directory>${famara.bundledDir}</directory><filtering>false</filtering></resource>
            <!-- 文本配置需要变量替换 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>craftengine/**</exclude>
                    <exclude>render-actors/*.zip</exclude>
                </excludes>
            </resource>
            <!-- CraftEngine 资源包含贴图与音效等二进制文件，不能做变量替换 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>craftengine/**</include>
                    <include>render-actors/*.zip</include>
                </includes>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- JNI is supplied by this pinned JOCL JAR; the system NVIDIA/OpenCL ICD is not bundled. -->
        <dependency>
            <groupId>org.jocl</groupId>
            <artifactId>jocl</artifactId>
            <version>2.0.6</version>
        </dependency>
        <!-- 只读解析原版静态形状定义，不加载客户端类；随插件隔离打包，不是前置插件。 -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <version>9.9.1</version>
        </dependency>
        <!-- Paper 已提供，显式固定编译接口；不重定位跨 CE 边界的 Gson/JOML。 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>1.10.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.2.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>ce-integration</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <dependencies>
        <!-- CE 仅供可选后端编译，运行时可完全不安装 -->
        <dependency>
            <groupId>net.momirealms</groupId>
            <artifactId>craft-engine-paper-plugin</artifactId>
            <version>${craftengine.version}</version>
            <scope>system</scope>
            <optional>true</optional>
            <systemPath>${project.basedir}/libs/craft-engine-paper-plugin-${craftengine.version}.jar</systemPath>
        </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>standalone</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration><excludes>
                    <exclude>**/CraftEngineBackend.java</exclude>
                    <exclude>**/LoadCraftEngine.java</exclude>
                </excludes>
                <testExcludes>
                    <!-- CE 后端测试仅在 ce-integration 编译/运行；纯核心与无 CE 测试仍执行。 -->
                    <testExclude>**/CeCompatTest.java</testExclude>
                </testExcludes></configuration>
            </plugin><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration><excludes>
                    <exclude>**/CeCompatTest.java</exclude>
                </excludes></configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
